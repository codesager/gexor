# =====================================================================
# GEXOR Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in your credentials.
# NEVER commit your '.env' file or secret keys to version control!
# =====================================================================

# 1. Public.com Brokerage Account ID (Account Number)
ACCOUNT_ID=12345

# 2. Public.com API Secret Key
# Generated in Public.com App under Account Settings > Security > API
# The PublicApiClient SDK exchanges this key for short-lived Bearer tokens automatically.
PUBLIC_SECRET_KEY=your_public_api_secret_key_here

# Optional Alias Key Name (supported fallback for PUBLIC_SECRET_KEY)
PUBLIC_API_KEY=your_public_api_secret_key_here

# 3. Optional Dashboard Password Protection
# Set a password string to require unlocking the Streamlit dashboard on startup.
# Leave blank (empty string) to disable password protection.
APP_PASSWORD=
